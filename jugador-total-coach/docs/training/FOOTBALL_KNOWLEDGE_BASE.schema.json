{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fut360: conocimiento documental de entrenamiento",
  "description": "Contrato de documentos internos. No habilita ejercicios ni prescribe cargas. practiceDefaults se aplica a todas las familias; no hay integración en runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "language",
    "purpose",
    "status",
    "runtimeIntegration",
    "professionalReview",
    "evidencePolicy",
    "sources",
    "channels",
    "capabilities",
    "claims",
    "modalities",
    "progressionPolicy",
    "practiceDefaults",
    "practices"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "language": {
      "const": "es"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "documentary-draft"
    },
    "runtimeIntegration": {
      "const": false
    },
    "professionalReview": {
      "const": false
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "proposed", "pending", "mediaRights", "inferenceBoundary"],
      "properties": {
        "verified": {
          "type": "string",
          "minLength": 1
        },
        "proposed": {
          "type": "string",
          "minLength": 1
        },
        "pending": {
          "type": "string",
          "minLength": 1
        },
        "mediaRights": {
          "type": "string",
          "minLength": 1
        },
        "inferenceBoundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "author",
          "title",
          "url",
          "publishedAt",
          "consultedAt",
          "accessKind",
          "inspectedScope",
          "limit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{2}$"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "publishedAt": {
            "type": "string",
            "minLength": 1
          },
          "consultedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "accessKind": {
            "enum": [
              "youtube-metadata",
              "publisher-text",
              "commercial-description",
              "coaching-text",
              "youtube-description",
              "title-only",
              "institutional-overview",
              "observational-study",
              "institutional-evidence-summary",
              "trial-abstract",
              "prior-reviewed-text"
            ]
          },
          "inspectedScope": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "sourceIds", "review", "next"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review": {
            "type": "string",
            "minLength": 1
          },
          "next": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "definition"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceIds", "statement", "evidenceKind"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C\\d{2}$"
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidenceKind": {
            "enum": [
              "topic-only",
              "publisher-claim",
              "coaching-principle",
              "described-task",
              "institutional-principle",
              "observational-association",
              "evidence-summary",
              "trial-specific"
            ]
          }
        }
      }
    },
    "modalities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "rulesetMustBeSpecified", "priorities", "adaptation"],
        "properties": {
          "id": {
            "enum": ["fut5", "fut7", "fut11"]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "rulesetMustBeSpecified": {
            "const": true
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "priorities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "adaptation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "progressionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "notALinearRequirement",
        "changeOneDemandAtATime",
        "dimensions",
        "gate",
        "jumpPolicy"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notALinearRequirement": {
          "type": "string",
          "minLength": 1
        },
        "changeOneDemandAtATime": {
          "const": true
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "jumpPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "practiceDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewStatus",
        "runtimeReady",
        "sourceRelation",
        "dose",
        "visualReview",
        "modalities",
        "commonStopRule",
        "delivery"
      ],
      "properties": {
        "status": {
          "const": "proposed"
        },
        "reviewStatus": {
          "const": "draft"
        },
        "runtimeReady": {
          "const": false
        },
        "sourceRelation": {
          "type": "string",
          "minLength": 1
        },
        "dose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {
              "const": "pending"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "visualReview": {
          "const": "pending"
        },
        "modalities": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["fut5", "fut7", "fut11"]
          }
        },
        "commonStopRule": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "practices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "capabilityIds",
          "evidenceRefs",
          "setup",
          "objective",
          "sequence",
          "regression",
          "progression",
          "observe",
          "limits",
          "modalityAdaptations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T\\d{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capabilityIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "setup": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spaceClass", "minimumParticipants", "equipment", "home2x2"],
            "properties": {
              "spaceClass": {
                "enum": [
                  "home",
                  "court",
                  "wall-area",
                  "pitch",
                  "goal-area",
                  "running-area",
                  "gym-or-home",
                  "training-area"
                ]
              },
              "minimumParticipants": {
                "type": "integer",
                "minimum": 1
              },
              "equipment": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "home2x2": {
                "enum": ["candidate-dimensions-pending", "not-suitable"]
              }
            }
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "regression": {
            "type": "string",
            "minLength": 1
          },
          "progression": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observe": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limits": {
            "type": "string",
            "minLength": 1
          },
          "modalityAdaptations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fut5", "fut7", "fut11"],
            "properties": {
              "fut5": {
                "type": "string",
                "minLength": 1
              },
              "fut7": {
                "type": "string",
                "minLength": 1
              },
              "fut11": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
