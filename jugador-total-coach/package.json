{
  "name": "jugador-total-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite --config apps/coach-pwa/vite.config.ts",
    "build": "vite build --config apps/coach-pwa/vite.config.ts",
    "preview": "vite preview --config apps/coach-pwa/vite.config.ts",
    "lint": "eslint apps packages tests tools/pnpm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write apps packages tests tools/pnpm.mjs package.json pnpm-workspace.yaml tsconfig.json vitest.config.ts eslint.config.js .prettierrc.json",
    "format:check": "prettier --check apps packages tests tools/pnpm.mjs package.json pnpm-workspace.yaml tsconfig.json vitest.config.ts eslint.config.js .prettierrc.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
