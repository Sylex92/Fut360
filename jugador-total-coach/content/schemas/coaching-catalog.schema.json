{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updatedAt",
    "status",
    "tasks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "planning-draft"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "videoId",
        "channel",
        "title",
        "start",
        "end",
        "match",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "channel": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "videoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "match": {
          "enum": [
            "demonstration",
            "component"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "familyId",
        "name",
        "category",
        "objective",
        "setup",
        "space",
        "participants",
        "equipment",
        "steps",
        "success",
        "mistakes",
        "easier",
        "harder",
        "limits",
        "modalities",
        "videos",
        "sourceRefs",
        "review"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "category": {
          "$ref": "#/$defs/text"
        },
        "objective": {
          "$ref": "#/$defs/text"
        },
        "setup": {
          "$ref": "#/$defs/text"
        },
        "space": {
          "$ref": "#/$defs/text"
        },
        "success": {
          "$ref": "#/$defs/text"
        },
        "mistakes": {
          "$ref": "#/$defs/text"
        },
        "easier": {
          "$ref": "#/$defs/text"
        },
        "harder": {
          "$ref": "#/$defs/text"
        },
        "limits": {
          "$ref": "#/$defs/text"
        },
        "id": {
          "type": "string",
          "pattern": "^[TMFBWCSY][0-9]{2}$"
        },
        "familyId": {
          "type": "string",
          "pattern": "^T[0-9]{2}$"
        },
        "participants": {
          "type": "integer",
          "minimum": 1
        },
        "equipment": {
          "$ref": "#/$defs/strings"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "sourceRefs": {
          "$ref": "#/$defs/strings"
        },
        "review": {
          "const": "documentary-draft"
        },
        "modalities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fut5",
            "fut7",
            "fut11"
          ],
          "properties": {
            "fut5": {
              "$ref": "#/$defs/text"
            },
            "fut7": {
              "$ref": "#/$defs/text"
            },
            "fut11": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "videos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/video"
          }
        },
        "localVideos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localVideo"
          }
        }
      }
    },
    "localVideo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "assetId",
        "title",
        "start",
        "end",
        "match",
        "note"
      ],
      "properties": {
        "provider": {
          "const": "local"
        },
        "id": {
          "$ref": "#/$defs/text"
        },
        "assetId": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "match": {
          "enum": [
            "demonstration",
            "component"
          ]
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
