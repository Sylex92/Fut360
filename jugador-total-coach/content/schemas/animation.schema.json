{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jugador-total.local/schemas/animation.schema.json",
  "title": "AnimationAsset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assetId",
    "version",
    "file",
    "sha256",
    "rigId",
    "rigMapping",
    "clipName",
    "fps",
    "durationMs",
    "loopable",
    "startPose",
    "endPose",
    "boundingBoxMeters",
    "requiredProps",
    "supportedSides",
    "previewSeparationMs",
    "practiceRepetitions",
    "authority",
    "reviewStatus"
  ],
  "properties": {
    "assetId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "file": { "type": "string", "pattern": "^assets/runtime/[a-z0-9-]+\\.glb$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rigId": { "type": "string", "minLength": 1 },
    "rigMapping": { "type": "string", "pattern": "^assets/manifests/[a-z0-9-]+\\.json$" },
    "clipName": { "type": "string", "pattern": "^EX_[a-z0-9-]+__[a-z0-9-]+__v[1-9][0-9]*$" },
    "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
    "durationMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
    "loopable": { "type": "boolean" },
    "startPose": { "type": "string", "minLength": 1 },
    "endPose": { "type": "string", "minLength": 1 },
    "boundingBoxMeters": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "$ref": "#/$defs/vector" },
        "max": { "$ref": "#/$defs/vector" }
      }
    },
    "requiredProps": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "supportedSides": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["none", "left", "right", "alternate"] }
    },
    "previewSeparationMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
    "practiceRepetitions": { "type": "integer", "minimum": 1, "maximum": 100 },
    "authority": { "const": "animation" },
    "reviewStatus": { "enum": ["draft", "technical-reviewed", "coaching-reviewed"] }
  },
  "$defs": {
    "vector": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
  }
}
